SERVER_PORT=8080
DB_HOST=aleph-postgres
DB_PORT=5432
DB_USERNAME=salomon_intra_app
DB_POOL_MAX_SIZE=5
# Required for local API execution. Do not commit the populated .env file.
DB_PASSWORD=
# Only the one-shot migrate profile needs these; never give them to the API.
DB_MIGRATION_USERNAME=salomon_intra_migrator
DB_MIGRATION_PASSWORD=
# Portainer compose configuration (paths point to files on the VPS).
INTRA_API_IMAGE=
INTRA_FRONT_IMAGE=
INTRA_DB_PASSWORD_FILE=
INTRA_MIGRATION_PASSWORD_FILE=


# Key AES-256-GCM para cuentas administrativas ZKTeco. Generar con: openssl rand -base64 32
# Definir el valor real solamente en las variables del stack Portainer; no subirlo a Git.
SALOMON_DEVICE_ADMIN_KEY=
